# Copy to .env and fill in
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/imovies?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
# Comma-separated list of allowed frontend origins (leave empty to allow all during development)
CLIENT_URL=http://localhost:5173
# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@imovies.com
ADMIN_PASSWORD=Admin@123
